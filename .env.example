# Firebase Web (valores públicos usados para registrar la PWA)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (solo servidor; nunca usar NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Aplicación y Supabase
NEXT_PUBLIC_APP_URL=https://p-delivery-delta.vercel.app
POSTGRES_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
P_DELIVERY_AUTH_SECRET=

# Google Routes y avisos del motorizado (solo servidor)
GOOGLE_MAPS_ROUTES_API_KEY=
ETA_BUFFER_BEFORE_MINUTES=2
ETA_BUFFER_AFTER_MINUTES=8
ETA_MAX_ACCURACY_METERS=100
ETA_REUSE_LOCATION_MINUTES=10
ETA_MOCK_DURATION_MINUTES=25
DEFAULT_COUNTRY_CODE=51

# Limpieza y escalamiento
PUSH_STALE_DAYS=30
PUSH_UNOPENED_ALERT_MINUTES=10
